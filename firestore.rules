rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Propriétaire : peut initialiser tous les restaurants et plats.
    function isOwner() {
      return signedIn() && me().role == 'owner';
    }
    // Admin d'un restaurant précis (rôle posé à la main dans la console).
    function isAdminOf(rid) {
      return signedIn() && me().role == 'admin' && me().restaurantId == rid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Un étudiant ne peut jamais se donner le rôle admin ou owner.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student';
      allow update, delete: if false;
    }

    match /restaurants/{rid} {
      allow read: if signedIn();
      allow write: if isOwner() || isAdminOf(rid);
    }

    match /menu_items/{id} {
      allow read: if signedIn();
      allow create: if isOwner() || isAdminOf(request.resource.data.restaurantId);
      allow update: if isOwner()
                    || (isAdminOf(resource.data.restaurantId)
                        && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if isOwner() || isAdminOf(resource.data.restaurantId);
    }

    match /orders/{id} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if signedIn()
                  && (resource.data.userId == request.auth.uid
                      || isAdminOf(resource.data.restaurantId));
      // L'admin ne peut changer que le statut.
      allow update: if isAdminOf(resource.data.restaurantId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // Avis : seulement par un client dont la commande est prête et contient ce plat.
    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'ready'
        && request.resource.data.dishId in get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.dishIds;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
